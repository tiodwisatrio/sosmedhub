APP_NAME=Sosmedhub
# Produksi: APP_ENV=production dan APP_DEBUG=false. Jangan pernah APP_DEBUG=true di server publik.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Alamat publik aplikasi. Selama media masih di disk lokal, Instagram mengambil foto/video dari alamat ini
# (APP_URL + /storage/...), jadi harus bisa dijangkau internet saat publikasi. Tanpa garis miring di akhir.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily = satu file per hari dengan rotasi (single membesar tanpa batas di server).
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# Produksi: warning atau error.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sosmedhub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi dengan HTTPS: aktifkan agar cookie sesi tidak dikirim lewat HTTP.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Harus lebih besar dari timeout job terlama (150 detik).
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: log (email ditulis ke log). Produksi lewat Resend SMTP: MAIL_MAILER=smtp, MAIL_HOST=smtp.resend.com,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<API key Resend>. Domain pengirim harus terverifikasi di Resend.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3 / Cloudflare R2). Dipakai hanya bila SCHEDULER_MEDIA_DISK=s3 dan paket
# league/flysystem-aws-s3-v3 sudah terpasang. R2: AWS_DEFAULT_REGION=auto, AWS_USE_PATH_STYLE_ENDPOINT=true,
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com. AWS_URL = alamat publik bucket/CDN yang bisa diambil Meta.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Instagram API (isi setelah punya Meta App). Redirect URI harus persis sama dengan yang terdaftar di dashboard Meta,
# dan host-nya harus sama dengan host tempat Anda membuka aplikasi (sesi login tidak terbawa antar host).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=${APP_URL}/admin/social-accounts/instagram/callback
INSTAGRAM_GRAPH_VERSION=v26.0
# Izin OAuth, dipisah koma. Kosong = bawaan. Izin baru harus sudah ada di kasus penggunaan app Meta.
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# Facebook Login untuk Halaman (App ID dan App Secret dari Settings > Basic, bukan ID Instagram)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/admin/social-accounts/facebook/callback
FACEBOOK_GRAPH_VERSION=v26.0
# Izin OAuth, dipisah koma. Kosong = bawaan. business_management wajib untuk Page milik Business Portfolio.
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,business_management

# --- Penjadwalan ---------------------------------------------------------
# Slot jadwal (menit) = interval cron. VPS dengan cron tiap menit: 1. Shared hosting: 15.
SCHEDULER_SLOT_MINUTES=1
# false bila queue:work dijalankan Supervisor (VPS). true bila tanpa Supervisor (lokal, shared hosting).
SCHEDULER_RUN_WORKER=true
SCHEDULER_WORKER_MAX_SECONDS=240
# Format yang macet di status publishing lebih lama dari ini (menit) ditandai gagal oleh scheduler:recover-stuck.
# Harus jauh di atas batas tunggu video (10 menit) ditambah waktu unggah.
SCHEDULER_STUCK_MINUTES=30
# Kirim email saat postingan berhasil terbit (email gagal selalu dikirim)
SCHEDULER_NOTIFY_PUBLISHED=true

# --- Media ---------------------------------------------------------------
# Disk penyimpanan media jadwal (nama disk di config/filesystems.php). public = lokal; s3 untuk object storage.
SCHEDULER_MEDIA_DISK=public
# Pengolahan foto (Imagick wajib). Versi terbit dihapus N hari setelah terbit; thumbnail tetap.
SCHEDULER_MAX_MEGAPIXELS=50
SCHEDULER_IMAGICK_MEMORY_MB=256
SCHEDULER_PUBLISH_RETENTION_DAYS=30

# --- Video ---------------------------------------------------------------
# Story maksimal 60 detik / 100MB (aturan Meta). Reels: Meta mengizinkan sampai 15 menit, batas di sini 3 menit
# (Facebook Reels 90 detik, diatur terpisah).
SCHEDULER_REEL_MAX_SECONDS=180
# Video di Feed Instagram (item carousel): batas konservatif sampai dites di akun asli.
SCHEDULER_FEED_VIDEO_MAX_SECONDS=60
# Jeda cek status video yang masih diproses Instagram (detik)
SCHEDULER_VIDEO_POLL_SECONDS=30
# Pemotongan video Story (lebih dari 60 detik) butuh ffmpeg. Isi path penuh bila PHP tidak menemukannya di PATH.
SCHEDULER_FFMPEG=ffmpeg
# Ukuran maksimal video sumber yang akan dipotong (MB) dan batas waktu proses ffmpeg (detik).
SCHEDULER_STORY_TRIM_SOURCE_MAX_MB=500
SCHEDULER_TRIM_TIMEOUT_SECONDS=600
# Unggah video butuh batas PHP dan web server yang cukup: upload_max_filesize >= 320M, post_max_size >= 512M,
# max_execution_time >= 120, dan client_max_body_size (Nginx) >= 512M.

# Akun developer awal untuk db:seed (password wajib diisi saat akun dibuat)
DEVELOPER_NAME="Developer"
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
